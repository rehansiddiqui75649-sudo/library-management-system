<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Login | Library Management</title><link rel="stylesheet" href="css/style.css"></head>
<body class="auth-page"><div class="auth-shell"><div class="auth-visual"><div class="auth-brand">LIBRARY<span>MANAGEMENT</span></div><div><div class="eyebrow">SMART LIBRARY</div><h2>Manage your library<br>with confidence.</h2><p>Books, students and borrowing transactions — all in one place.</p></div><div class="auth-stat"><b>100+</b><span>student members ready in the demo database</span></div></div><div class="auth-card"><div class="brand">LIBRARY</div><h1>Welcome back</h1><p class="muted">Sign in to access your admin dashboard.</p>
<%if("1".equals(request.getParameter("logout"))){%><div class="alert success">✓ You have been logged out.</div><%}%><%if(request.getAttribute("error")!=null){%><div class="alert danger"><%=request.getAttribute("error")%></div><%}%>
<form action="login" method="post"><label>Email</label><input type="email" name="email" placeholder="admin@library.com" required><label>Password</label><input type="password" name="password" placeholder="admin123" required><button class="btn primary" type="submit">Sign in →</button></form><p class="hint">Demo admin: <b>admin@library.com</b> / <b>admin123</b></p></div></div></body></html>

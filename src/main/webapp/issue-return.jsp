<%@ page import="java.util.List" %>
<%@ page import="com.rehan.library.model.User" %>
<%@ page import="com.rehan.library.model.Book" %>
<%@ page import="com.rehan.library.model.IssueRecord" %>
<% List<User> users=(List<User>)request.getAttribute("users"); List<Book> books=(List<Book>)request.getAttribute("books"); List<IssueRecord> issues=(List<IssueRecord>)request.getAttribute("issues"); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Issue & Return | Library Management</title><link rel="stylesheet" href="css/style.css"></head>
<body><div class="app"><aside class="sidebar"><div class="brand"><div>LIBRARY</div><span>MANAGEMENT</span></div><nav><a href="dashboard"><span>⌂</span> Dashboard</a><a href="books"><span>▤</span> Books</a><a href="books#add"><span>＋</span> Add Book</a><a class="active" href="issue-return"><span>↔</span> Issue / Return</a><a href="members"><span>♙</span> Members</a><a href="logout"><span>↪</span> Logout</a></nav></aside>
<main class="content"><header class="page-head"><div><div class="eyebrow">TRANSACTIONS</div><h1>Issue & Return</h1><p>Manage book borrowing and returns from one place.</p></div></header>
<%if(request.getAttribute("error")!=null){%><div class="alert danger"><%=request.getAttribute("error")%></div><%}%><%String success=request.getParameter("success");if("issue".equals(success)){%><div class="alert success">✓ Book issued successfully.</div><%}else if("return".equals(success)){%><div class="alert success">✓ Book returned successfully.</div><%}%>
<section class="transaction-grid"><div class="panel"><div class="panel-title"><div><h2>Issue a Book</h2><p>Select a student and an available book.</p></div></div><form class="form-grid single" action="issue-return" method="post"><input type="hidden" name="action" value="issue"><div><label>Student</label><select name="userId" required><option value="">Choose student</option><%for(User u:users){if("MEMBER".equalsIgnoreCase(u.getRole())){%><option value="<%=u.getId()%>"><%=u.getName()%> — <%=u.getEmail()%></option><%}}%></select></div><div><label>Book</label><select name="bookId" required><option value="">Choose available book</option><%for(Book b:books){if(b.getAvailableQuantity()>0){%><option value="<%=b.getId()%>"><%=b.getTitle()%> — <%=b.getAvailableQuantity()%> available</option><%}}%></select></div><button class="btn primary" type="submit">↗ Issue Book</button></form></div><div class="info-card"><div class="info-icon">↔</div><h3>How it works</h3><p>Issuing a book automatically decreases its available quantity and creates a transaction record.</p><p>Returning it restores the available quantity and closes the transaction.</p></div></section>
<section class="panel"><div class="panel-title"><div><h2>Active Issues</h2><p><%=issues.size()%> book(s) currently issued.</p></div></div><div class="table-wrap"><table><thead><tr><th>Student</th><th>Book</th><th>Issue Date</th><th>Status</th><th>Action</th></tr></thead><tbody><%if(issues.isEmpty()){%><tr><td colspan="5"><div class="empty-state"><div>✓</div><b>No active issues</b><span>All books are currently returned.</span></div></td></tr><%}else{for(IssueRecord r:issues){%><tr><td><b><%=r.getUserName()%></b></td><td><%=r.getBookTitle()%></td><td><%=r.getIssueDate()%></td><td><span class="status issued">ISSUED</span></td><td><form action="issue-return" method="post"><input type="hidden" name="action" value="return"><input type="hidden" name="issueId" value="<%=r.getId()%>"><input type="hidden" name="bookId" value="<%=r.getBookId()%>"><button class="btn small success-btn" type="submit">Return</button></form></td></tr><%}}%></tbody></table></div></section>
</main></div></body></html>
